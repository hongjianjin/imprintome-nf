/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Wiring test on placeholder (empty) IDATs; run it with -stub:

        nextflow run hongjianjin/imprintome-nf -r main -profile test -stub --outdir results_test

    The test samplesheet lists the placeholder IDATs by their raw GitHub URLs,
    so the test runs from any launch directory (needs internet access).

    For a real-data test, point --input at a samplesheet of real IDATs.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '8.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline wiring (use with -stub)'

    input     = "${projectDir}/assets/test_data/samplesheet_test.csv"
    cohort    = 'test'
    platform  = 'EPIC'
    probesets = 'selected,NanoImprint'
}
