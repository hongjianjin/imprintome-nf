/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to the command in the module.
        ext.prefix = File name prefix for output files.
        ext.when   = Conditional clause
    Options of the imprintomeR scripts not exposed as pipeline parameters
    (e.g. --radar-all TRUE) can be appended here or in a custom -c config.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'RUN_METHQC' {
        ext.args = { [
            params.platform       ? "--platform ${params.platform}" : '',
            "--pcutoff ${params.pcutoff}",
            "--icutoff ${params.icutoff}",
            "--normalization ${params.normalization}",
            "--plot-types ${params.qc_plot_types}",
            params.skip_qc_plots  ? '--no-qc-plots'    : '',
            params.skip_qc_report ? '--no-qc-report'   : '',
            '--verbose'
        ].findAll { it }.join(' ') }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: 'methqc'
        ]
    }

    withName: 'RUN_IMPRINTOMER' {
        ext.args = { [
            "--genome ${params.genome_build}",
            "--plot-types ${params.imprint_plot_types}",
            "--ids-cutoff ${params.ids_cutoff}",
            "--balance ${params.balance}",
            "--infinium-type ${params.infinium_type}",
            params.reference_group    ? "--reference-group ${params.reference_group}" : '',
            params.dmr_type           ? "--dmr-type ${params.dmr_type}"               : '',
            params.icr                ? '--icr'                                       : '',
            params.skip_imprint_plots ? '--skip-plots'                                : '',
            params.n_boot             ? "--n-boot ${params.n_boot} --resample ${params.resample} --conf-level ${params.conf_level}" : '',
            params.resample_reference ? '--resample-reference'                        : '',
            params.n_perm             ? "--n-perm ${params.n_perm}"                   : '',
            params.permute            ? "--permute ${params.permute}"                 : '',
            params.seed != null       ? "--seed ${params.seed}"                       : '',
            '--verbose'
        ].findAll { it }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/imprintomer" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
